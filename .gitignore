# Rust build artifacts
/target
**/target/

# Cargo lock — keep at workspace root, ignore in sub-crates if any
# Cargo.lock  # kept intentionally for reproducible builds

# Test snapshots generated by soroban/stellar test tooling
test_snapshots/
**/test_snapshots/
**/*.snap
**/*.snap.new
**/*.snap.tmp

# Proptest / cargo-fuzz regression artifacts
proptest-regressions/
**/proptest-regressions/
fuzz/corpus/
fuzz/artifacts/

# macOS
.DS_Store
**/.DS_Store

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Local AI tool config/state, never pushed
.claude/
.kiro/

# Environment / secrets
.env
.env.*
!.env.example

# Node / frontend tooling (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Wasm build outputs (already inside target, but explicit for clarity)
*.wasm

# Stellar CLI generated files
.stellar/

# Local-only notes, never pushed
issue.md
*.local.md

# Temporary / OS files
Thumbs.db
*.tmp
*.bak
